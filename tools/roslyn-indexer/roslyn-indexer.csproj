<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CLI must select the same TFM major as the SDK shipping Roslyn DLLs.
         The .NET 8 default only supports manual SDK 8 builds; the Python runner
         always passes RoslynIndexerTargetFramework for SDK 8/9/10+. -->
    <TargetFramework Condition="'$(RoslynIndexerTargetFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(RoslynIndexerTargetFramework)' != ''">$(RoslynIndexerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- 使用已安裝 SDK 隨附的 Roslyn，不下載 NuGet 分析器。 -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
