{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted adversarial second-pass challenge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "agent_instance_id",
    "snapshot_fingerprint",
    "hypothesis",
    "line_challenges",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "agent_instance_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "snapshot_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 1000
      }
    },
    "line_challenges": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line",
            "sha256"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attacker_precondition",
        "expected_violation",
        "inspection_steps",
        "observed_behavior",
        "evidence"
      ],
      "properties": {
        "attacker_precondition": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1800
        },
        "expected_violation": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1800
        },
        "inspection_steps": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1800
        },
        "observed_behavior": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1800
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "line_start",
            "line_end",
            "line_hash",
            "summary"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            },
            "line_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "summary": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      }
    }
  }
}
