          ],
          "properties": {
            "type": {
              "const": "authorized-human"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "credential_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "basis": {
          "enum": [
            "verified-authorized-operation",
            "false-positive",
            "policy-correction",
            "additional-evidence"
          ]
        },
        "basis_evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_ruling": {
          "enum": [
            "upheld",
            "overturned"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "origin": {
          "const": "trusted-review-channel"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "timestamp",
        "run_id",
        "batch_id",
        "stage",
        "boundary_level",
        "batch_sequence",
        "batch_fingerprint",
        "previous_event_sha256",
        "event_sha256",
        "related_event_id",
        "previous_review_event_id",
        "reviewer",
        "basis",
        "basis_evidence_sha256",
        "final_ruling",
        "reviewed_at",
        "artifact_sha256",
        "origin"
      ]
    },
