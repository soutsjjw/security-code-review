{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Security Review Standard Rules v2",
  "type": "object",
  "required": [
    "schema_version",
    "ruleset_id",
    "ruleset_version",
    "release_status",
    "categories",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "ruleset_id": {
      "const": "company-security-code-review-70"
    },
    "ruleset_version": {
      "const": "2.0.0-rc1"
    },
    "release_status": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10
    },
    "rules": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "control_objective",
          "applicability",
          "inspection",
          "assessment",
          "evidence_requirements",
          "references",
          "governance",
          "normative_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "control_objective": {
            "type": "string",
            "minLength": 3
          },
          "applicability": {
            "type": "object"
          },
          "inspection": {
            "type": "object"
          },
          "assessment": {
            "type": "object"
          },
          "evidence_requirements": {
            "type": "object"
          },
          "references": {
            "type": "object"
          },
          "governance": {
            "type": "object"
          },
          "normative_notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
