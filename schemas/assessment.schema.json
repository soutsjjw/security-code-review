{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Code Review Assessment v2",
  "type": "object",
  "required": [
    "ruleset_version",
    "project_id",
    "git_revision",
    "assessment_date",
    "scope",
    "checks",
    "findings"
  ],
  "properties": {
    "ruleset_version": {
      "enum": [
        "2.0.0",
        "2.0.0-rc1"
      ],
      "description": "正式版 2.0.0；僅為保留舊 assessment.json 審查紀錄相容舊版 2.0.0-rc1。不得自動把舊檢核視為本次新對照已執行。"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "git_revision": {
      "type": "string",
      "minLength": 7
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 3
    },
    "checks": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "applicability_reason",
          "decision_reason",
          "evidence",
          "reviewer",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "review",
              "na"
            ]
          },
          "applicability_reason": {
            "type": "string",
            "minLength": 5
          },
          "decision_reason": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "description",
                "collected_on",
                "source_version"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "test",
                    "configuration",
                    "deployment",
                    "operating_record",
                    "policy",
                    "scan",
                    "interview",
                    "other"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 8
                },
                "collected_on": {
                  "type": "string",
                  "format": "date"
                },
                "source_version": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "artifact_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "redacted": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "reviewer": {
            "type": "string",
            "minLength": 2
          },
          "exception_id": {
            "type": "string"
          },
          "review_kind": {
            "enum": ["static_done_external_pending", "external_only", "external_responsibility_pending"],
            "description": "僅 status=review 使用：static_done_external_pending＝靜態查核已完成、僅缺部署／政策／動態證據；external_only＝本規則本質上需外部或制度證據；external_responsibility_pending＝已取得可定位的委外控制責任證據，但控制結果仍缺必要外部工件。"
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution": {
            "type": "object",
            "required": [
              "state",
              "methods",
              "summary"
            ],
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "completed",
                  "blocked"
                ]
              },
              "methods": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "inspected_paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "finding_amendments": {
      "type": "array",
      "description": "保留由單一寫入者審查交易產生的 Finding 修訂前內容與雙向雜湊，不得由 staged payload 直接指定。",
      "items": {
        "type": "object",
        "required": ["finding_id", "previous_sha256", "updated_sha256", "previous_finding",
                     "reason", "reviewer", "recorded_on"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "previous_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "updated_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "previous_finding": {"type": "object"},
          "reason": {"type": "string", "minLength": 40},
          "reviewer": {"type": "string", "minLength": 4},
          "recorded_on": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    },
    "fail_withdrawals": {
      "type": "array",
      "description": "以反證撤回誤判的已確認 fail；由單一寫入者整合器產生並保留原 Finding 全文，不得由 staged payload 直接指定。",
      "items": {
        "type": "object",
        "required": ["rule_id", "previous_status", "new_status", "previous_check_sha256",
                     "finding_ids", "withdrawn_findings", "finding_sha256", "reason",
                     "first_pass_error", "counter_evidence", "reviewer", "recorded_on"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "previous_status": {"const": "fail"},
          "new_status": {"enum": ["pass", "na", "review"]},
          "previous_check_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "withdrawn_findings": {"type": "array", "items": {"type": "object"}},
          "finding_sha256": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "reason": {"type": "string", "minLength": 40},
          "first_pass_error": {"type": "string", "minLength": 30},
          "counter_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "line_start", "line_end", "description"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "description": {"type": "string", "minLength": 20}
              },
              "additionalProperties": false
            }
          },
          "reviewer": {"type": "string", "minLength": 4},
          "recorded_on": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "check_ids",
          "impact",
          "evidence",
          "remediation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "description",
                "collected_on",
                "source_version"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "test",
                    "configuration",
                    "deployment",
                    "operating_record",
                    "policy",
                    "scan",
                    "interview",
                    "other"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 8
                },
                "collected_on": {
                  "type": "string",
                  "format": "date"
                },
                "source_version": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "artifact_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "redacted": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "remediation": {
            "type": "string",
            "minLength": 5
          },
          "confidence": {
            "enum": [
              "confirmed",
              "high",
              "medium",
              "low"
            ]
          },
          "impact_type": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["confidentiality", "integrity", "availability"]
            },
            "description": "影響面向；嚴重度須與其對應（僅影響可用性者不宜直接列為 high）。"
          },
          "verification": {
            "type": "object",
            "properties": {
              "usage_traced": {
                "type": "string",
                "minLength": 10,
                "description": "已追查引用的變數／方法確實被使用或傳出的說明；抑制死碼啟發式。"
              },
              "design_notes": {
                "type": "string",
                "minLength": 5,
                "description": "引用片段附近的註解／文件是否說明刻意設計，以及如何納入判斷；抑制註解警示。"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "approver",
          "accepted_by",
          "expires_on",
          "compensating_controls",
          "justification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "approver": {
            "type": "string"
          },
          "accepted_by": {
            "type": "string"
          },
          "expires_on": {
            "type": "string",
            "format": "date"
          },
          "compensating_controls": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scope_details": {
      "type": "object",
      "description": "由審查 Agent 記錄範圍，統計數量由來源檔與檢核紀錄計算",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 3
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "file_reviews": {
      "type": "array",
      "description": "逐檔實際閱讀及 10 類規則適用性篩選；正式報告需要完整原始碼覆蓋，已有審查結果不自動補造。",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "summary",
          "methods",
          "category_screening",
          "rule_reviews"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "summary": {
            "type": "string",
            "minLength": 20
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "category_screening": {
            "type": "object",
            "required": [
              "AC",
              "AU",
              "IN",
              "CR",
              "EH",
              "LG",
              "DP",
              "PD",
              "BC",
              "SI"
            ],
            "properties": {
              "AC": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "AU": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "IN": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "CR": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "EH": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "LG": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "DP": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "PD": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "BC": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              },
              "SI": {
                "type": "object",
                "required": [
                  "rule_ids",
                  "reason"
                ],
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "candidate_exclusions": {
          "type": "array",
          "description": "語意候選確實不適用時逐條記錄理由；不可由工具自動填寫",
          "items": {
            "type": "object",
            "required": ["rule_id", "reason"],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
              },
              "reason": {
                "type": "string",
                "minLength": 40
              }
            },
            "additionalProperties": false
          }
        },
        "rule_reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "result",
                "reason",
                "line_start",
                "line_end"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
                },
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "review"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 20
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "semantic_review": {
                  "type": "object",
                  "description": "人工核對非慣用命名的實際控制。須與正式同規則來源證據交集；非 Regex 自動放行。",
                  "required": ["control_behavior", "call_chain", "verification_method"],
                  "properties": {
                    "control_behavior": {"type": "string", "minLength": 40},
                    "call_chain": {"type": "string", "minLength": 40},
                    "verification_method": {"type": "string", "minLength": 20}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
