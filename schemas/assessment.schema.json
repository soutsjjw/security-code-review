{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Code Review Assessment v2",
  "type": "object",
  "required": [
    "ruleset_version",
    "project_id",
    "git_revision",
    "assessment_date",
    "scope",
    "checks",
    "findings"
  ],
  "properties": {
    "ruleset_version": {
      "const": "2.0.0-rc1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "git_revision": {
      "type": "string",
      "minLength": 7
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 3
    },
    "checks": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "applicability_reason",
          "decision_reason",
          "evidence",
          "reviewer",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(AC|AU|IN|CR|EH|LG|DP|PD|BC|SI)-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "review",
              "na"
            ]
          },
          "applicability_reason": {
            "type": "string",
            "minLength": 5
          },
          "decision_reason": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "description",
                "collected_on",
                "source_version"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "test",
                    "configuration",
                    "deployment",
                    "operating_record",
                    "policy",
                    "scan",
                    "interview",
                    "other"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 8
                },
                "collected_on": {
                  "type": "string",
                  "format": "date"
                },
                "source_version": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "artifact_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "redacted": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "reviewer": {
            "type": "string",
            "minLength": 2
          },
          "exception_id": {
            "type": "string"
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution": {
            "type": "object",
            "required": [
              "state",
              "methods",
              "summary"
            ],
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "completed",
                  "blocked"
                ]
              },
              "methods": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "inspected_paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "check_ids",
          "impact",
          "evidence",
          "remediation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "description",
                "collected_on",
                "source_version"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "test",
                    "configuration",
                    "deployment",
                    "operating_record",
                    "policy",
                    "scan",
                    "interview",
                    "other"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 8
                },
                "collected_on": {
                  "type": "string",
                  "format": "date"
                },
                "source_version": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "artifact_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "redacted": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "remediation": {
            "type": "string",
            "minLength": 5
          },
          "confidence": {
            "enum": [
              "confirmed",
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "approver",
          "accepted_by",
          "expires_on",
          "compensating_controls",
          "justification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "approver": {
            "type": "string"
          },
          "accepted_by": {
            "type": "string"
          },
          "expires_on": {
            "type": "string",
            "format": "date"
          },
          "compensating_controls": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scope_details": {
      "type": "object",
      "description": "由審查 Agent 記錄範圍，統計數量由來源檔與檢核紀錄計算",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 3
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
