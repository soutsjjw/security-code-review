  "title": "Security Code Review HTML Report Envelope v2.1.0",
  "description": "與既有 2.0.0-rc1 assessment.schema.json 相容；供通用 HTML 模板使用。",
  "type": "object",
  "required": [
    "report_schema_version",
    "project",
    "assessment",
    "rules",
    "presentation"
