                      "properties": {
                        "status": {
                          "enum": [
                            "pass",
                            "fail"
                          ]
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "then": {
                      "properties": {
                        "evidence": {
                          "minItems": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "na"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "then": {
                      "properties": {
                        "applicability_reason": {
                          "minLength": 12
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "evidence": {
                        "items": {
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "kind": {
                                    "const": "source"
                                  }
                                },
                                "required": [
                                  "kind"
                                ]
                              },
                              "then": {
                                "required": [
                                  "path",
                                  "line_start",
                                  "line_end"
                                ]
                              }
                            },
                            {
                              "if": {
                                "properties": {
                                  "kind": {
                                    "enum": [
                                      "deployment",
                                      "operating_record",
                                      "policy"
                                    ]
                                  }
                                },
                                "required": [
                                  "kind"
                                ]
                              },
                              "then": {
                                "required": [
                                  "artifact_id"
                                ]
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            },
