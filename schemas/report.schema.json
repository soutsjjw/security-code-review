        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "assessment": {
      "allOf": [
        {
          "$ref": "assessment.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "allOf": [
                  {
