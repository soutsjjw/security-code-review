    "presentation": {
      "type": "object",
      "properties": {
        "demo": {
          "type": "boolean"
        },
        "review_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "overall_risk": {
          "type": "object",
          "required": [
            "level",
            "summary"
          ],
          "properties": {
            "level": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "info",
                "review"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "finding_ids"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string"
              },
              "finding_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "finding_details": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/finding_detail"
          }
        },
        "footer": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope_inventory": {
      "type": "object",
      "description": "從受測工作目錄及 completed 的 inspected_paths 自動衍生，不能人工填入統計數字",
      "required": [
        "basis",
        "inventory_file_count",
        "eligible_file_count",
        "excluded_file_count",
        "reviewed_file_count",
        "reviewed_files",
        "file_types",
        "declared_project_count",
        "reviewed_project_count",
        "projects",
        "excluded_paths"
      ],
      "properties": {
        "basis": {
          "const": "working-tree-filesystem"
        },
        "inventory_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "check_ids"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "check_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "file_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "declared_project_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reviewed_project_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "reviewed_file_count"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "reviewed_file_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason",
              "file_count"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "file_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "finding_detail": {
      "type": "object",
      "properties": {
        "owasp_category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "line_start",
              "line_end"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "before_code": {
          "type": "string"
        },
        "after_code": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
